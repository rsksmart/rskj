{
  "name": "txpool_content",
  "summary": "Returns the transactions currently in the pool, in full.",
  "description": "Returns two maps, `pending` and `queued`, keyed by sender address and then by nonce. `pending` holds transactions eligible for the next block; `queued` holds those whose nonce leaves a gap and which therefore cannot be executed yet.",
  "params": [],
  "result": {
    "name": "content",
    "description": "The pending and queued transactions, in full",
    "schema": {
      "title": "txPoolContent",
      "type": "object",
      "properties": {
        "pending": {
          "$ref": "#/components/schemas/TxPoolTransactionsBySender"
        },
        "queued": {
          "$ref": "#/components/schemas/TxPoolTransactionsBySender"
        }
      }
    }
  },
