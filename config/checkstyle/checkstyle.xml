<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Check that files end with a newline -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <module name="TreeWalker">
        <!-- equals()/hashCode() contract must be kept in sync -->
        <module name="EqualsHashCode"/>

        <!-- equals(SpecificType) without a real equals(Object) override hides a bug -->
        <module name="CovariantEquals"/>

        <!-- == / != on a String literal instead of .equals() -->
        <module name="StringLiteralEquality"/>

        <!-- Java-style array declarations only: Type[] name, not Type name[] -->
        <module name="ArrayTypeStyle"/>

        <!-- Modifiers must appear in JLS order (public static final, not static public final) -->
        <module name="ModifierOrder"/>

        <!-- Long literals must use uppercase L (1L, not 1l) -->
        <module name="UpperEll"/>

        <!-- Stray empty statements (extra ;) -->
        <module name="EmptyStatement"/>

        <!-- Empty catch blocks must at least contain a comment explaining why -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_CATCH"/>
        </module>

        <!-- Unused imports; strict mode does not give a pass to imports only referenced in Javadoc -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- Modifiers that add nothing: public/abstract on interface methods, static on
             nested interfaces, final on methods of a final class or on private methods -->
        <module name="RedundantModifier"/>

        <!-- Overriding a method without @Override hides typos in the signature -->
        <module name="MissingOverride"/>

        <!-- A switch "default" clause that isn't physically last -->
        <module name="DefaultComesLast"/>

        <!-- if (x) return true; else return false; instead of return x; -->
        <module name="SimplifyBooleanReturn"/>

        <!-- Duplicate imports, or importing from java.lang / the current package -->
        <module name="RedundantImport"/>

        <!-- Overriding Object.clone()/finalize(): legacy APIs that are easy to get wrong -->
        <module name="NoClone"/>
        <module name="NoFinalizer"/>

        <!-- Switch case falls through to the next case without a comment marking it intentional -->
        <module name="FallThrough"/>

        <!-- Stray empty statements EmptyStatement doesn't cover -->
        <module name="UnnecessarySemicolonAfterOuterTypeDeclaration"/>
        <module name="UnnecessarySemicolonInTryWithResources"/>
        <module name="UnnecessarySemicolonInEnumeration"/>

        <!-- Boolean expressions/comparisons that can be written more directly,
             e.g. "if (b == true)" instead of "if (b)" -->
        <module name="SimplifyBooleanExpression"/>

        <!-- One variable declaration per statement: "int a, b;" -> "int a; int b;" -->
        <module name="MultipleVariableDeclarations"/>
    </module>
</module>
