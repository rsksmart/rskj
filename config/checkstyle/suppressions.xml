<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Puppy Crawl//DTD Suppressions 1.0//EN" "suppressions_1_0.dtd">
<suppressions>
    <!-- Custom checkstyle suppressions -->

    <!-- Fuzz tests intentionally catch-and-ignore the exception a malformed/random
         input is expected to throw during decoding; that's the fuzzing idiom, not a
         swallowed error, so don't force a "why is this empty" comment here. -->
    <suppress checks="EmptyBlock" files="[\\/]src[\\/]fuzzTest[\\/]"/>
</suppressions>
